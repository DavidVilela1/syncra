# ╔══════════════════════════════════════════════════════════════════════════╗
# ║ Syncra (Matrix) — environment variables                                  ║
# ║ Local dev: copy to .env. Railway: see railway/web.env and railway/ws.env ║
# ║ (paste into each service's Raw Editor).                                  ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ── Runtime ──────────────────────────────────────────────────────────────────
# Railway: "production" on both services.
NODE_ENV="development"

# ── Database (web + ws) ──────────────────────────────────────────────────────
# Local:   postgres://postgres:postgres@localhost:5432/matrix
# Railway: ${{Postgres.DATABASE_URL}}  → postgres://…@postgres.railway.internal:5432/railway (private network)
#          For one-off commands from your laptop (seed), use ${{Postgres.DATABASE_PUBLIC_URL}} instead.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/matrix"
# "true" for direct connections (local, Railway Postgres). "false" behind a transaction pooler
# (Supabase :6543, Neon "-pooler"), which can't handle prepared statements.
DATABASE_PREPARE="false"
# Only needed when DATABASE_URL is a transaction pooler and REDIS_URL is unset:
# a direct/session URL for LISTEN/NOTIFY realtime. Not needed on Railway.
REALTIME_DATABASE_URL=""

# ── Redis (web + ws, optional locally, recommended in production) ────────────
# Railway: ${{Redis.REDIS_URL}} → redis://default:…@redis.railway.internal:6379 (private network)
# When set: distributed rate limiting, presence and pub/sub across all instances.
# When empty: Postgres LISTEN/NOTIFY for realtime + in-process rate limiting.
REDIS_URL=""

# ── Auth (web + ws — MUST be identical on both) ──────────────────────────────
# ≥32 chars. Generate: openssl rand -base64 48
# Railway: create a Shared Variable AUTH_SECRET, reference it as ${{shared.AUTH_SECRET}}.
AUTH_SECRET="replace-with-a-long-random-string-of-at-least-32-chars"
# Enables /api/dev/login for SEEDED demo users in production. Keep false unless it's a public demo.
DEMO_LOGIN_ENABLED="false"

# ── Web app (web) ────────────────────────────────────────────────────────────
# Public URL of the WebSocket service. Inlined at BUILD time.
# Railway: wss://${{ws.RAILWAY_PUBLIC_DOMAIN}}
NEXT_PUBLIC_WS_URL="ws://localhost:3001"
# Used only by the seed script to print login links. Railway: https://<your web domain>
APP_URL="http://localhost:3000"

# ── WebSocket server (ws) ────────────────────────────────────────────────────
# Railway injects PORT automatically — the server prefers it. WS_PORT is the local fallback.
WS_PORT="3001"
# Origins allowed to open a socket, comma-separated, no trailing slash.
# Railway: https://${{web.RAILWAY_PUBLIC_DOMAIN}}  (plus any custom domain)
ALLOWED_ORIGINS="http://localhost:3000"
# Max simultaneous sockets per user (tabs × devices).
WS_MAX_CONNECTIONS_PER_USER="10"
# (web + ws) "true" ONLY behind a proxy you control (Railway: true on BOTH services) so the
# rightmost X-Forwarded-For hop is trusted for per-IP rate limits.
TRUST_PROXY="false"
