{
  "name": "matrix",
  "version": "0.1.0",
  "private": true,
  "description": "Matrix — a real-time collaborative Kanban board built with Next.js, tRPC, Drizzle and TanStack Query.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -n next,ws -c blue,magenta \"next dev\" \"tsx watch server/ws.ts\"",
    "dev:next": "next dev",
    "dev:ws": "tsx watch server/ws.ts",
    "build": "next build",
    "build:server": "esbuild server/ws.ts scripts/migrate.ts scripts/seed.ts --bundle --platform=node --format=esm --target=node22 --packages=external --sourcemap --outdir=dist --entry-names=[name] --out-extension:.js=.mjs",
    "start": "next start",
    "start:ws": "node --enable-source-maps dist/ws.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "node --enable-source-maps dist/migrate.mjs",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:prod": "node --enable-source-maps dist/seed.mjs"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.103.2",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@trpc/tanstack-react-query": "^11.19.0",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.3",
    "drizzle-orm": "^0.45.3",
    "geist": "^1.7.2",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "superjson": "^2.2.6",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
