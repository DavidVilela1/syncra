# ── Railway › ws service › Variables › Raw Editor ──────────────────────────
# PORT is injected by Railway; the WS server listens on it (dual-stack "::").

NODE_ENV="production"
DATABASE_URL="${{Postgres.DATABASE_URL}}"
DATABASE_PREPARE="true"
REDIS_URL="${{Redis.REDIS_URL}}"
AUTH_SECRET="${{shared.AUTH_SECRET}}"

# Only the web app may open sockets (Cross-Site WebSocket Hijacking defence).
# Add your custom domain here too if you attach one, comma-separated.
ALLOWED_ORIGINS="https://${{web.RAILWAY_PUBLIC_DOMAIN}}"

WS_MAX_CONNECTIONS_PER_USER="10"
# Railway's edge proxy sets X-Forwarded-For → per-IP handshake limits see real client IPs.
TRUST_PROXY="true"
