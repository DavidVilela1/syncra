# ── Railway › web service › Variables › Raw Editor ─────────────────────────
# Paste as-is. ${{…}} are Railway reference variables, resolved at build AND runtime.
# Assumes your canvas services are named exactly: web, ws, Postgres, Redis.

NODE_ENV="production"

# Private network (postgres.railway.internal) — no egress fees, never public.
DATABASE_URL="${{Postgres.DATABASE_URL}}"
# Railway Postgres is a direct connection (no PgBouncer) → prepared statements are safe and faster.
DATABASE_PREPARE="true"

# Private network (redis.railway.internal). Enables the shared rate limiter, presence and pub/sub.
REDIS_URL="${{Redis.REDIS_URL}}"

# Same secret on web + ws (sessions are minted by web, WS tickets verified by ws).
AUTH_SECRET="${{shared.AUTH_SECRET}}"

# Inlined into the browser bundle at BUILD time — changing it requires a redeploy.
NEXT_PUBLIC_WS_URL="wss://${{ws.RAILWAY_PUBLIC_DOMAIN}}"

# Railway's edge appends the real client IP as the LAST X-Forwarded-For hop.
# Required for per-IP limits on room creation/joins — without it every visitor shares one bucket.
TRUST_PROXY="true"

# Passwordless sign-in for seeded demo users. Keep "false" unless this is a public demo.
DEMO_LOGIN_ENABLED="false"
